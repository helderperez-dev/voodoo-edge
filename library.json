{
  "name": "voodoo-edge",
  "version": "1.0.0",
  "description": "C++ SDK for connecting physical devices to the Voodoo Runtime. Features Device facade, connection manager, MQTT/HTTP transport, HAL (GPIO/PWM/ADC/I2C/SPI), and hardware components (LED, button, motor, servo, relay, buzzer, encoder, sensors).",
  "keywords": "voodoo, iot, edge, mqtt, http, esp32, arduino, embedded, hal, motor, servo, sensor",
  "repository": {
    "type": "git",
    "url": "https://github.com/helderperez-dev/voodoo-edge.git"
  },
  "authors": [
    {
      "name": "Helder Perez",
      "email": "helder@nicegoodthings.com"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/helderperez-dev/voodoo-edge",
  "frameworks": "arduino",
  "platforms": [
    "espressif32",
    "atmelavr",
    "atmelsam",
    "ststm32",
    "rp2040"
  ],
  "headers": "voodoo_edge.h",
  "build": {
    "srcDir": "src",
    "includeDir": "include"
  },
  "export": {
    "include": [
      "src/**",
      "examples/**",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "library.properties"
    ],
    "exclude": [
      "tests/**",
      "tools/**",
      "docs/**",
      ".github/**",
      ".pio/**",
      ".vscode/**",
      "ROADMAP.md"
    ]
  }
}